{#
/**
 * @file
 * CVSS score with a gauge. Colors come from the parent severity modifier.
 *
 * Variables:
 * - cvss: value with one decimal and percent for the gauge.
 * - size: optional, 'large' on the bulletin page.
 */
#}
<div class="cvss-score{{ size == 'large' ? ' cvss-score--large' }}">
  <span class="cvss-score__label">{{ 'CVSS score'|t }}</span>
  <p class="cvss-score__value">
    <span class="cvss-score__number">{{ cvss.value }}</span>
    <span class="cvss-score__max">/ 10</span>
  </p>
  <div class="cvss-score__gauge" role="img" aria-label="{{ 'Gauge: @score out of 10'|t({'@score': cvss.value}) }}">
    <div class="cvss-score__fill" style="width: {{ cvss.percent }}%"></div>
  </div>
</div>