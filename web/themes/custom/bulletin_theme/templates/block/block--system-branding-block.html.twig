{% extends "block.html.twig" %}
{#
/**
 * @file
 * Site branding: logo and site name in a single link to the home page.
 */
#}
{% block content %}
  <a class="site-branding" href="{{ path('<front>') }}" rel="home">
    {% if site_logo %}
      {# EMPTY ALT: THE SITE NAME NEXT TO IT ALREADY NAMES THE LINK #}
      <img class="site-branding__logo" src="{{ site_logo }}" alt="" width="42" height="42">
    {% endif %}
    {% if site_name %}
      <span class="site-branding__name">{{ site_name }}</span>
    {% endif %}
  </a>
{% endblock %}