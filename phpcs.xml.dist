<?xml version="1.0" encoding="UTF-8"?>
<ruleset name="drupal-security-bulletins">
  <description>Coding standards for the custom module and theme.</description>

  <!-- ONLY CUSTOM CODE IS CHECKED: CORE AND CONTRIB FOLLOW THEIR OWN RULES. -->
  <file>web/modules/custom</file>
  <file>web/themes/custom</file>

  <!-- PHP AND DRUPAL FILE TYPES. TWIG, CSS AND MARKDOWN ARE NOT CHECKED. -->
  <arg name="extensions" value="php,module,inc,install,test,theme,info,yml"/>
  <arg name="colors"/>
  <arg value="sp"/>

  <rule ref="Drupal"/>
  <rule ref="DrupalPractice"/>
</ruleset>