<?xml version="1.0" encoding="UTF-8"?>
<!-- TEST CONFIGURATION, RUN INSIDE DDEV: ddev exec vendor/bin/phpunit -->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="web/core/tests/bootstrap.php"
         colors="true"
         cacheDirectory=".phpunit.cache"
         failOnWarning="true"
         failOnRisky="true">
  <php>
    <ini name="error_reporting" value="32767"/>
    <ini name="memory_limit" value="-1"/>
    <!-- DATABASE FOR KERNEL TESTS: THE DDEV POSTGRESQL SERVICE. TABLES GET A RANDOM PREFIX. -->
    <env name="SIMPLETEST_DB" value="pgsql://db:db@db/db"/>
    <env name="SIMPLETEST_BASE_URL" value="http://web"/>
    <env name="SYMFONY_DEPRECATIONS_HELPER" value="disabled"/>
  </php>
  <testsuites>
    <testsuite name="unit">
      <directory>web/modules/custom/*/tests/src/Unit</directory>
    </testsuite>
    <testsuite name="kernel">
      <directory>web/modules/custom/*/tests/src/Kernel</directory>
    </testsuite>
  </testsuites>
</phpunit>